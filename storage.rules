rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clips/{allPaths=**} {
      // Public read access for downloading Persib clips and photos
      allow read: if true;
      
      // Upload allowed for authenticated admins and owner
      allow write: if request.auth != null && 
        (request.resource.size < 100 * 1024 * 1024) && // 100MB limit
        (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('image/.*'));
      
      // Delete allowed for owner
      allow delete: if request.auth != null;
    }
    
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "apriliansyahazril10@gmail.com")
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
